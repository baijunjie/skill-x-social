{
  "name": "skill-x-social",
  "version": "1.0.0",
  "description": "X (Twitter) browser automation skill — post, like, reply, retweet, and quote tweets via Playwright",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:post": "echo '{\"content\":\"Test tweet\"}' | npx tsx scripts/post.ts",
    "setup": "npx tsx scripts/setup.ts"
  },
  "dependencies": {
    "playwright": "^1.58.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
